{
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://grammarflow-brain.onrender.com/api/:path*" }
  ],
  "headers": [
    {
      "source": "/(.+)\\.(js|css|png|ico|svg|woff2?)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
