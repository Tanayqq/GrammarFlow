{
  "version": 2,
  "name": "grammarflow-web",
  "public": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.+)\\.(js|css|png|ico|svg|woff2?)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
