{
  "manifest_version": 3,
  "name": "GrammarFlow AI Writer",
  "version": "2.7",
  "description": "Instant AI writing assistant with multilingual support. Rewrite, fix grammar, summarize, and explain — on any webpage.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "https://grammarflow-brain.onrender.com/*",
    "<all_urls>"
  ]
}
